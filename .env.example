# =========================================================================
# Shooting Star — environment configuration template
# Copy this to `.env` and fill in real values. NEVER commit .env.
# =========================================================================

# --- Runtime mode ---
# One of: dev | paper | live
SHOOTING_STAR_MODE=dev

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json           # json | console
LOG_FILE=logs/shooting-star.log

# --- Storage ---
DATA_DIR=./data
DUCKDB_PATH=./data/shooting-star.duckdb
SQLITE_PATH=./data/metadata.db
PARQUET_DIR=./data/parquet

# --- Redis (event bus) ---
REDIS_URL=redis://localhost:6379/0

# --- Zerodha Kite (paper/live only — leave blank in dev) ---
# Get from https://developers.kite.trade
KITE_API_KEY=
KITE_API_SECRET=
# Access token is refreshed daily via OAuth; leave blank on first run
KITE_ACCESS_TOKEN=

# --- LLM providers (for L1/L2/L3 agents) ---
ANTHROPIC_API_KEY=
# Optional overrides
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_STANDARD=claude-sonnet-4-6
ANTHROPIC_MODEL_REASONING=claude-opus-4-6

# --- Agent budget caps (INR per day, per agent) ---
AGENT_DAILY_BUDGET_INR=500
AGENT_MONTHLY_BUDGET_INR=10000

# --- Risk engine ---
# Portfolio greek limits — ₹ per 1% NIFTY move / 1 vol point / 1% NIFTY move
MAX_NET_DELTA_INR_PER_1PCT_NIFTY=15000
MAX_NET_VEGA_INR_PER_1_VOL_POINT=8000
MAX_NET_GAMMA_INR_PER_1PCT_NIFTY=5000

# Kill switches (% of capital)
DAILY_LOSS_KILL_PCT=3.0
WEEKLY_LOSS_KILL_PCT=6.0
PER_STRATEGY_LOSS_KILL_PCT=4.0

# --- Capital allocation ---
TOTAL_CAPITAL_INR=2000000
OPTION_BUY_CAPITAL_INR=20000
OPTION_SELL_CAPITAL_INR=1980000

# --- Charges (buffer applied on top of computed charges when sizing) ---
CHARGES_BUFFER_PCT=10
